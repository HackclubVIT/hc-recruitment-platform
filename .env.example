# ==========================================
# HC RECRUITMENT PLATFORM - PRODUCTION ENV
# ==========================================
# This file serves as documentation for the required production environment variables.
# Do NOT commit real passwords, secrets, or tokens to version control.

# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================
# The recruitment API shares the main Hack Club database.
# Must point to the primary PostgreSQL instance.
DATABASE_URL="postgresql://username:password@host:5432/hc_main?schema=public"

# (Optional) For E2E testing ONLY. Must point to an ISOLATED database.
# Never point this to the live database!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hc_recruitment_test?schema=public"

# ==========================================
# 2. AUTHENTICATION & SECURITY
# ==========================================
# Secret key used for signing JWT cookies. Generate a strong 64-character random string.
JWT_SECRET="generate_a_secure_random_string_here"

# ==========================================
# 3. CORS & ORIGIN CONFIGURATION
# ==========================================
# Allowed frontend origins. Comma-separated if multiple.
# Do NOT use '*' in production.
ALLOWED_ORIGIN="https://recruitment.hackclubvit.co"

# ==========================================
# 4. API BINDING (Backend)
# ==========================================
PORT=3001

# ==========================================
# 5. FRONTEND CONFIGURATION (For Next.js)
# ==========================================
# Point this to the deployed Express API
NEXT_PUBLIC_API_URL="https://api.recruitment.hackclubvit.co/api"
