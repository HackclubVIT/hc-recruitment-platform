# Base URL for the HackClub VIT Shared Backend API service.
# In local development, defaults to '/api' (proxied by Vite to http://localhost:5000).
# In production, point to your deployed API server (e.g. 'https://api.hackclubvit.in/api' or 'https://hackclub-api.onrender.com/api').
VITE_API_BASE_URL="http://localhost:5000/api"
