# Database
# SQLite for zero-setup local dev; swap to Neon PostgreSQL for prod:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=""

# Email (nodemailer/Gmail SMTP) — optional; if absent, emails log to console
SMTP_USER=""
SMTP_PASS=""

# Frontend URL for email links
FRONTEND_URL="http://localhost:3000"

# Upstream API Configuration
# Base URL for the canonical API service
# In local development, point to the independent Express server:
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGIN="https://recruitment.hackclubvit.co"