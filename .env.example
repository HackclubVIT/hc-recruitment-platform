# Database connection string for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/hc_recruitment?schema=public"

# JWT secret key for session authentication (MANDATORY in production)
JWT_SECRET="your-secure-random-secret-here"

# Base URL for the canonical API service
# In local development, leave empty to use the same origin
# In production, point to your deployed API server
NEXT_PUBLIC_API_URL=""

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGIN="https://recruitment.hackclubvit.co"
