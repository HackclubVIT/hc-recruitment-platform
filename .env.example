# ========================================================
# HACKCLUB VIT RECRUITMENT PLATFORM - FRONTEND ENVIRONMENT
# ========================================================
# This repository is a static frontend-only Next.js application.
# All backend APIs and database operations are served by hc-api.

# 1. Unified Backend API URL (Required in production)
# Set this to the public URL of the deployed hc-api service.
# Example for local development: http://localhost:5000
# Example for production Render: https://hackclub-vit-api.onrender.com
# Example for custom domain: https://api.hackclubvit.co
NEXT_PUBLIC_API_URL="http://localhost:5000"

# 2. GitHub Pages Base Path (Optional)
# Only required if deploying to a GitHub Pages subfolder (https://<user>.github.io/<repo>/).
# If deploying to a root domain (e.g. recruitment.hackclubvit.co), leave this empty.
# Example: /hc-recruitment-platform
NEXT_PUBLIC_BASE_PATH=""
