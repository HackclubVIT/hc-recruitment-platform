# ========================================================
# HACKCLUB VIT RECRUITMENT PLATFORM - ENVIRONMENT CONFIG
# ========================================================
# Copy this file to .env and fill in real values.
# Never commit .env — it is excluded by .gitignore.

# 1. Next.js Frontend API URL (Required)
# URL of the deployed Express API server (no trailing slash, no /api suffix).
# Local development default: http://localhost:3001
# Production example:        https://api.hackclubvit.co
NEXT_PUBLIC_API_URL="http://localhost:3001"

# 2. Database (Required — used by API)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 3. JWT Secret (Required in production)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# 4. App Public URL (Required in production)
# Used in outgoing emails to link back to the recruitment portal.
# Example: https://recruitment.hackclubvit.co
APP_URL="http://localhost:3000"

# 5. Dev Auth Bypass (Development only — MUST be false/absent in production)
# When true, enables test accounts (admin.test@hackclubvit.local etc.)
DEV_AUTH_BYPASS=false

# 6. SMTP Email Settings (Required for email notifications)
SMTP_ENCRYPTION_KEY="change-this-to-a-long-random-secret-in-production"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_FROM_NAME="HackClub VIT"

# 7. GitHub Pages Base Path (Optional)
# Only required if deploying to a subfolder path.
# Leave empty for root domain deployments.
NEXT_PUBLIC_BASE_PATH=""
