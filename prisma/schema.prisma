// HackClub VIT Chennai — Recruitment & Interview Management Platform
// Prisma schema for Recruiter & Lead modules
// Provider: SQLite (dev) → swap to PostgreSQL/Neon for prod via DATABASE_URL
// 
// KEY DESIGN DECISIONS:
// - User.id uses BigInt to match main site's user ID scale
// - User.department is a String (name), not FK - matches main site schema
// - Department linkage via name lookup in application code
// - All timestamps use DateTime with @default(now()) and @updatedAt
// - Cascade deletes for dependent records (notes, history, interviews)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * User - All system users (admin, lead, recruiter, panel, candidate)
 * Synced from main site via auth proxy
 * role: ADMIN | LEAD | RECRUITER | PANEL | CANDIDATE | MEMBER
 * department: String name (looked up in Department table for deptIds)
 * isReviewer: Legacy field for panelist eligibility
 */
model User {
  id                 BigInt  @id
  name               String
  email              String? @unique
  password           String?
  role               String  @default("Member")
  department         String?
  isReviewer         Boolean @default(false)
  avatar             String?
  
  // Relations
  assignedApps       Application[]           @relation("AssignedRecruiter")
  notes              ApplicationNote[]
  statusChanges      StatusHistory[]         @relation("StatusChangedBy")
  createdInterviews  Interview[]             @relation("InterviewCreatedBy")
  panelistAssignments InterviewPanelist[]
  feedbacks          Feedback[]
  notifications      Notification[]

  @@map("users")
}

/**
 * Department - Organizational units (Technical, Design, Operations, etc.)
 * Referenced by Application.departmentId (FK)
 * User.department stores name as String for main site compatibility
 */
model Department {
  id          Int    @id @default(autoincrement())
  name        String @unique
  slug        String @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]

  @@map("departments")
}

// Removed UserDepartment since department is a string in main site User model

/**
 * Application - Candidate application with full recruitment data
 * status: APPLIED → UNDER_REVIEW → ON_HOLD → SHORTLISTED → INTERVIEW_SCHEDULED → INTERVIEWED → SELECTED/WAITLISTED/REJECTED
 * technicalSkills: JSON string array ["React", "TypeScript"]
 * answers: JSON string object { whyJoin: "...", projectDetails: "..." }
 * assignedRecruiterId: BigInt (FK to User)
 */
model Application {
  id                  Int                @id @default(autoincrement())
  departmentId        Int
  name                String
  email               String
  registerNumber      String
  phoneNumber         String?
  yearOfStudy         String
  roleAppliedFor      String
  resumeUrl           String?
  technicalSkills     String             @default("[]")
  answers             String             @default("{}")
  status              String             @default("APPLIED") // APPLIED, UNDER_REVIEW, ON_HOLD, SHORTLISTED, INTERVIEW_SCHEDULED, INTERVIEWED, SELECTED, WAITLISTED, REJECTED
  assignedRecruiterId BigInt?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  department          Department         @relation(fields: [departmentId],        references: [id], onDelete: Cascade)
  assignedRecruiter   User?              @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  notes               ApplicationNote[]
  history             StatusHistory[]
  interviews          Interview[]

  @@index([departmentId])
  @@index([status])
  @@index([assignedRecruiterId])
  @@map("applications")
}

/**
 * ApplicationNote - Internal notes on applications
 * authorId: BigInt (FK to User)
 */
model ApplicationNote {
  id            Int      @id @default(autoincrement())
  applicationId Int
  authorId      BigInt
  body          String
  createdAt     DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId],      references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

/**
 * StatusHistory - Audit trail of application status changes
 * fromStatus: null for initial creation
 * changedByUserId: BigInt (FK to User who made the change)
 */
model StatusHistory {
  id            Int                @id @default(autoincrement())
  applicationId Int
  fromStatus    String?            // APPLIED, UNDER_REVIEW, ON_HOLD, SHORTLISTED, INTERVIEW_SCHEDULED, INTERVIEWED, SELECTED, WAITLISTED, REJECTED
  toStatus      String             // APPLIED, UNDER_REVIEW, ON_HOLD, SHORTLISTED, INTERVIEW_SCHEDULED, INTERVIEWED, SELECTED, WAITLISTED, REJECTED
  changedByUserId BigInt
  changedAt     DateTime           @default(now())
  reason        String?

  application   Application @relation(fields: [applicationId],      references: [id], onDelete: Cascade)
  changedBy     User        @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("status_history")
}

/**
 * Interview - Scheduled interview with panelists
 * mode: ONLINE | OFFLINE
 * status: SCHEDULED | RESCHEDULED | COMPLETED | CANCELLED | NO_SHOW
 * panelists: Many-to-many via InterviewPanelist
 */
model Interview {
  id                Int            @id @default(autoincrement())
  applicationId     Int
  startTime         DateTime
  endTime           DateTime
  mode              String         // ONLINE, OFFLINE
  locationOrLink    String
  status            String         @default("SCHEDULED") // SCHEDULED, RESCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  createdByUserId   BigInt
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  application       Application     @relation(fields: [applicationId],     references: [id], onDelete: Cascade)
  createdBy         User            @relation("InterviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  panelists         InterviewPanelist[]
  feedbacks         Feedback[]

  @@index([applicationId])
  @@index([status])
  @@index([startTime])
  @@map("interviews")
}

/**
 * InterviewPanelist - Many-to-many: Interview ↔ User (panelist)
 * Composite primary key (interviewId, panelistUserId)
 */
model InterviewPanelist {
  interviewId     Int
  panelistUserId  BigInt

  interview       Interview @relation(fields: [interviewId],     references: [id], onDelete: Cascade)
  panelist        User      @relation(fields: [panelistUserId],  references: [id], onDelete: Cascade)

  @@id([interviewId, panelistUserId])
  @@map("interview_panelists")
}

/**
 * Feedback - Panelist feedback for an interview
 * ratings: JSON string object { technical: 4, communication: 5, ... }
 * overall: 0-100 score
 * recommendation: STRONG_HIRE | HIRE | MAYBE | NO_HIRE
 * Unique constraint: one feedback per panelist per interview
 */
model Feedback {
  id                Int                   @id @default(autoincrement())
  interviewId       Int
  panelistUserId    BigInt
  ratings           String                @default("{}")
  overall           Int
  recommendation    String                // STRONG_HIRE, HIRE, MAYBE, NO_HIRE
  comments          String?
  submittedAt       DateTime              @default(now())

  interview         Interview @relation(fields: [interviewId],       references: [id], onDelete: Cascade)
  panelist          User      @relation(fields: [panelistUserId],    references: [id], onDelete: Cascade)

  @@unique([interviewId, panelistUserId])
  @@map("feedbacks")
}

/**
 * Notification - In-app notifications for users
 * type: APPLICATION_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_RESCHEDULED | INTERVIEW_CANCELLED | DECISION_MADE | FEEDBACK_SUBMITTED
 * relatedEntityType: "application" | "interview" | etc.
 * relatedEntityId: ID of related entity
 */
model Notification {
  id                 Int      @id @default(autoincrement())
  userId             BigInt
  type               String
  message            String
  relatedEntityType  String?
  relatedEntityId    Int?
  isRead             Boolean  @default(false)
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}