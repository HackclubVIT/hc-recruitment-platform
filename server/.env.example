# Neon PostgreSQL connection string — paste yours here (Neon dashboard → Connection string).
# Use the pooled connection string and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret for session tokens.
JWT_SECRET="your-strong-random-jwt-secret-key"

# Gmail SMTP credentials for sending password reset emails (App Password, not your login password).
SMTP_USER="your-club-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Allowed CORS Origins (comma-separated for multiple origins, e.g. "https://hackclubvit.in,https://recruitment.hackclubvit.in")
# In development, defaults to local Vite/frontend ports automatically.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:4173"

# Frontend URL — used to generate password reset links sent in emails.
# Development: http://localhost:5173
# Production: https://your-production-domain.com
FRONTEND_URL="http://localhost:5173"

# Server port (optional, defaults to 5000).
PORT=5000

# Environment mode ('development' | 'production')
NODE_ENV="development"

